@model SmartHospital.Domain.Billing.Invoice
@{
    Layout = null;
    var hospital = ViewBag.Hospital as SmartHospital.Domain.Organization.Hospital;
    var patient = ViewBag.Patient as SmartHospital.Domain.Patients.Patient;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Bảng kê chi phí &amp; Phiếu thu - @Model.InvoiceCode</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>@@media print { .no-print { display: none; } } body { max-width: 820px; margin: 20px auto; }</style>
</head>
<body>
    <div class="p-4 border">
        <div class="fw-bold">@hospital?.Name</div>
        <h5 class="text-center fw-bold my-3">BẢNG KÊ CHI PHÍ KHÁM CHỮA BỆNH &amp; PHIẾU THU (@Model.InvoiceCode)</h5>
        <p class="small"><strong>Bệnh nhân:</strong> @patient?.FullName (@patient?.PatientCode) | <strong>Ngày lập:</strong> @HospitalTime.ToVietnamTime(Model.IssuedAtUtc).ToString("dd/MM/yyyy HH:mm")</p>
        <table class="table table-sm table-bordered small">
            <thead><tr><th>Diễn giải</th><th class="text-end">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr><td>@item.Description</td><td class="text-end">@item.Quantity</td><td class="text-end">@item.UnitPriceSnapshot.ToString("N0")</td><td class="text-end">@item.LineTotal.ToString("N0")</td></tr>
                }
            </tbody>
        </table>
        <div class="text-end small">
            <div>Tổng chi phí: <strong>@Model.TotalAmount.ToString("N0") đ</strong></div>
            <div>Bệnh nhân phải trả: <strong>@Model.PatientResponsibilityAmount.ToString("N0") đ</strong> | Đã thanh toán: <strong>@Model.PaidAmount.ToString("N0") đ</strong></div>
        </div>
        <div class="no-print mt-3"><button onclick="window.print()" class="btn btn-sm btn-primary">In bảng kê / phiếu thu</button></div>
    </div>
</body>
</html>
