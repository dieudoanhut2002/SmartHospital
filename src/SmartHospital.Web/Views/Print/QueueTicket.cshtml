@model SmartHospital.Domain.Reception.QueueTicket
@{
    Layout = null;
    var hospital = ViewBag.Hospital as SmartHospital.Domain.Organization.Hospital;
    var patient = ViewBag.Patient as SmartHospital.Domain.Patients.Patient;
    var encounter = ViewBag.Encounter as SmartHospital.Domain.Reception.Encounter;
    var clinic = ViewBag.Clinic as SmartHospital.Domain.Organization.Clinic;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Phiếu tiếp nhận &amp; Số thứ tự - @Model.TicketNumber</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>@@media print { .no-print { display: none; } } body { max-width: 420px; margin: 20px auto; }</style>
</head>
<body>
    <div class="border p-4 text-center">
        <div class="fw-bold">@hospital?.Name</div>
        <div class="small text-muted mb-3">PHIẾU TIẾP NHẬN &amp; SỐ THỨ TỰ KHÁM</div>
        <div class="display-4 fw-bold my-2">@Model.TicketNumber</div>
        <div class="fw-semibold">@clinic?.Name</div>
        <hr />
        <div class="text-start small">
            <div><strong>Bệnh nhân:</strong> @patient?.FullName (@patient?.PatientCode)</div>
            <div><strong>Mã lượt khám:</strong> @encounter?.EncounterCode</div>
            <div><strong>Thời gian cấp:</strong> @HospitalTime.ToVietnamTime(Model.IssuedAtUtc).ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <div class="mt-3 no-print"><button onclick="window.print()" class="btn btn-sm btn-primary">In phiếu</button></div>
    </div>
</body>
</html>
