@model SmartHospital.Web.Controllers.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="sh-card p-4">
            <h5 class="fw-bold mb-2">Đổi mật khẩu tài khoản</h5>
            @if (Model.Forced)
            {
                <div class="alert alert-warning small">
                    Đây là lần đăng nhập đầu tiên hoặc mật khẩu vừa được đặt lại. Bạn bắt buộc phải đổi mật khẩu trước khi tiếp tục sử dụng hệ thống.
                </div>
            }

            <form asp-action="ChangePassword" method="post">
                <input type="hidden" asp-for="Forced" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="mb-3">
                    <label class="form-label">Mật khẩu hiện tại</label>
                    <input asp-for="CurrentPassword" class="form-control" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Mật khẩu mới (tối thiểu 8 ký tự, gồm chữ hoa, thường, số, ký tự đặc biệt)</label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Xác nhận mật khẩu mới</label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary">Cập nhật mật khẩu</button>
                @if (!Model.Forced)
                {
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2">Quay lại</a>
                }
            </form>
        </div>
    </div>
</div>
