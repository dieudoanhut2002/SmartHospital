@model IReadOnlyList<SmartHospital.Application.Admin.RoleDto>
@{
    ViewData["Title"] = "Vai trò & Ma trận quyền";
    var allPerms = ViewBag.AllPermissions as IReadOnlyList<SmartHospital.Application.Admin.PermissionDto> ?? [];
    var grouped = allPerms.GroupBy(p => p.Module).ToList();
}

<div class="sh-card p-3 mb-3">
    <h6 class="fw-bold mb-2">Tạo vai trò tùy chỉnh mới</h6>
    <form asp-action="CreateRole" method="post" class="row g-2">
        <div class="col-md-3"><input name="name" class="form-control form-control-sm" placeholder="Mã vai trò (VD: QualityStaff)*" required /></div>
        <div class="col-md-4"><input name="displayName" class="form-control form-control-sm" placeholder="Tên hiển thị*" required /></div>
        <div class="col-md-3"><input name="description" class="form-control form-control-sm" placeholder="Mô tả" /></div>
        <div class="col-md-2"><button type="submit" class="btn btn-sm btn-primary w-100">+ Tạo vai trò</button></div>
    </form>
</div>

<div class="accordion" id="rolesAccordion">
    @foreach (var role in Model)
    {
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#r_@role.Id">
                    <span class="fw-bold me-2">@role.Name</span> (@role.DisplayName)
                    <span class="badge bg-primary ms-2">@role.PermissionCodes.Count quyền</span>
                </button>
            </h2>
            <div id="r_@role.Id" class="accordion-collapse collapse" data-bs-parent="#rolesAccordion">
                <div class="accordion-body">
                    <form asp-action="UpdatePermissions" method="post">
                        <input type="hidden" name="roleId" value="@role.Id" />
                        <div class="row g-3">
                            @foreach (var grp in grouped)
                            {
                                <div class="col-md-4 col-lg-3">
                                    <div class="border rounded p-2 h-100">
                                        <div class="fw-bold small text-primary mb-2">@grp.Key</div>
                                        @foreach (var p in grp)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="permissionCodes" value="@p.Code"
                                                       checked="@role.PermissionCodes.Contains(p.Code)" />
                                                <label class="form-check-label small" title="@p.Code">@p.Name</label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary mt-3">Lưu quyền cho @role.Name</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
