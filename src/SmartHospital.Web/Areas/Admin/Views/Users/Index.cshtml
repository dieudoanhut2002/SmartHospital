@model SmartHospital.Contracts.Common.PagedResult<SmartHospital.Application.Admin.UserListItemDto>
@{
    ViewData["Title"] = "Quản lý tài khoản & Phạm vi";
}

<div class="sh-card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Tìm tên đăng nhập, họ tên, mã NV..." />
            <button class="btn btn-sm btn-outline-primary" type="submit">Tìm kiếm</button>
        </form>
        <a asp-action="Create" class="btn btn-sm btn-primary">+ Tạo tài khoản mới</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tài khoản</th>
                    <th>Họ và tên</th>
                    <th>Mã NV</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@u.UserName</td>
                        <td>@u.FullName</td>
                        <td>@u.EmployeeCode</td>
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <span class="badge bg-secondary me-1">@r</span>
                            }
                        </td>
                        <td>
                            @if (!u.IsActive)
                            {
                                <span class="badge bg-danger">Đã khóa</span>
                            }
                            else if (u.IsLockedOut)
                            {
                                <span class="badge bg-warning text-dark">Khóa tạm (sai MK)</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            @if (u.MustChangePassword)
                            {
                                <span class="badge bg-info text-dark">Chờ đổi MK</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Sửa / Phân quyền</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
