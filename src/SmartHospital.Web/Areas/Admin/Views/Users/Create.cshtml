@{
    ViewData["Title"] = "Tạo tài khoản người dùng";
    var roles = ViewBag.Roles as IReadOnlyList<SmartHospital.Application.Admin.RoleDto> ?? [];
    var facilities = ViewBag.Facilities as IReadOnlyList<SmartHospital.Domain.Organization.Facility> ?? [];
    var departments = ViewBag.Departments as IReadOnlyList<SmartHospital.Domain.Organization.Department> ?? [];
}

<div class="sh-card p-4">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tên đăng nhập *</label>
                <input name="userName" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Họ và tên *</label>
                <input name="fullName" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Mã nhân viên</label>
                <input name="employeeCode" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Email</label>
                <input name="email" type="email" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Mật khẩu khởi tạo *</label>
                <input name="password" type="password" class="form-control" required minlength="8" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input name="mustChangePassword" type="checkbox" value="true" class="form-check-input" checked />
                    <label class="form-check-label">Bắt buộc đổi mật khẩu lần đầu</label>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Cơ sở mặc định</label>
                <select name="defaultFacilityId" class="form-select">
                    @foreach (var f in facilities)
                    {
                        <option value="@f.Id">@f.Code - @f.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Khoa/Phòng mặc định</label>
                <select name="defaultDepartmentId" class="form-select">
                    <option value="">-- Không cố định --</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">@d.Code - @d.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Vai trò (Roles)</label>
                <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                    @foreach (var r in roles)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="roles" value="@r.Name" id="role_@r.Id" />
                            <label class="form-check-label small" for="role_@r.Id">@r.Name - @r.DisplayName</label>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Phạm vi Cơ sở &amp; Khoa/Phòng</label>
                <div class="border rounded p-2 mb-2">
                    @foreach (var f in facilities)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="facilityScopeIds" value="@f.Id" checked />
                            <label class="form-check-label small">Cơ sở: @f.Name</label>
                        </div>
                    }
                </div>
                <div class="border rounded p-2" style="max-height: 150px; overflow-y: auto;">
                    @foreach (var d in departments)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="departmentScopeIds" value="@d.Id" />
                            <label class="form-check-label small">@d.Name</label>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Lưu tài khoản</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy</a>
        </div>
    </form>
</div>
