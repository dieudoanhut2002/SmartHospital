@model SmartHospital.Application.Admin.UserListItemDto
@{
    ViewData["Title"] = $"Cập nhật tài khoản: {Model.UserName}";
    var roles = ViewBag.Roles as IReadOnlyList<SmartHospital.Application.Admin.RoleDto> ?? [];
    var facilities = ViewBag.Facilities as IReadOnlyList<SmartHospital.Domain.Organization.Facility> ?? [];
    var departments = ViewBag.Departments as IReadOnlyList<SmartHospital.Domain.Organization.Department> ?? [];
    var facScopes = ViewBag.FacilityScopeIds as IReadOnlyList<Guid> ?? [];
    var deptScopes = ViewBag.DepartmentScopeIds as IReadOnlyList<Guid> ?? [];
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="sh-card p-4">
            <h6 class="fw-bold mb-3">Thông tin &amp; Phân quyền</h6>
            <form asp-action="Edit" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Họ và tên *</label>
                        <input name="fullName" value="@Model.FullName" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Mã NV</label>
                        <input name="employeeCode" value="@Model.EmployeeCode" class="form-control" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input name="isActive" type="checkbox" value="true" class="form-check-input" checked="@Model.IsActive" />
                            <label class="form-check-label">Đang hoạt động</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input name="email" value="@Model.Email" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Cơ sở mặc định</label>
                        <select name="defaultFacilityId" class="form-select">
                            @foreach (var f in facilities)
                            {
                                <option value="@f.Id" selected="@(f.Id == Model.DefaultFacilityId)">@f.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Vai trò</label>
                        <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                            @foreach (var r in roles)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="roles" value="@r.Name" checked="@Model.Roles.Contains(r.Name)" />
                                    <label class="form-check-label small">@r.Name - @r.DisplayName</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Phạm vi Cơ sở &amp; Khoa/Phòng</label>
                        <div class="border rounded p-2 mb-2">
                            @foreach (var f in facilities)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="facilityScopeIds" value="@f.Id" checked="@facScopes.Contains(f.Id)" />
                                    <label class="form-check-label small">@f.Name</label>
                                </div>
                            }
                        </div>
                        <div class="border rounded p-2" style="max-height: 150px; overflow-y: auto;">
                            @foreach (var d in departments)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="departmentScopeIds" value="@d.Id" checked="@deptScopes.Contains(d.Id)" />
                                    <label class="form-check-label small">@d.Name</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Quay lại</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sh-card p-3 mb-3">
            <h6 class="fw-bold">Đặt lại mật khẩu</h6>
            <form asp-action="ResetPassword" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-2">
                    <label class="form-label small">Mật khẩu mới *</label>
                    <input name="newPassword" type="password" class="form-control form-control-sm" required minlength="8" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Lý do *</label>
                    <input name="reason" class="form-control form-control-sm" required value="Yêu cầu đặt lại mật khẩu" />
                </div>
                <div class="form-check mb-2">
                    <input name="mustChangePassword" type="checkbox" value="true" class="form-check-input" checked />
                    <label class="form-check-label small">Bắt buộc đổi mật khẩu</label>
                </div>
                <button type="submit" class="btn btn-sm btn-warning">Đặt lại mật khẩu</button>
            </form>
        </div>

        <div class="sh-card p-3">
            <h6 class="fw-bold">Vô hiệu hóa / Kích hoạt</h6>
            <form asp-action="ToggleActive" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="isActive" value="@(!Model.IsActive ? "true" : "false")" />
                <div class="mb-2">
                    <label class="form-label small">Lý do</label>
                    <input name="reason" class="form-control form-control-sm" required placeholder="Nghỉ việc / khôi phục..." />
                </div>
                <button type="submit" class="btn btn-sm @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                    @(Model.IsActive ? "Vô hiệu hóa tài khoản" : "Kích hoạt lại")
                </button>
            </form>
        </div>
    </div>
</div>
