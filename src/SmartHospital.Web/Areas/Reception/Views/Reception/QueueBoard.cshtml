@model IReadOnlyList<SmartHospital.Application.Reception.QueueTicketDto>
@{
    ViewData["Title"] = "Tiếp đón & Bảng hàng đợi phòng khám";
    var clinics = ViewBag.Clinics as IReadOnlyList<SmartHospital.Domain.Organization.Clinic> ?? [];
    var departments = ViewBag.Departments as IReadOnlyList<SmartHospital.Domain.Organization.Department> ?? [];
    var patients = ViewBag.Patients as IReadOnlyList<SmartHospital.Contracts.Patients.PatientSummaryDto> ?? [];
    var activeFacId = (Guid)(ViewBag.ActiveFacilityId ?? Guid.Empty);
    var selectedPatientId = ViewBag.SelectedPatientId as Guid?;
    var opdDeptId = departments.FirstOrDefault(d => d.DepartmentType == DepartmentType.Outpatient)?.Id ?? departments.FirstOrDefault()?.Id ?? Guid.Empty;
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="sh-card p-3">
            <h6 class="fw-bold mb-3">Tiếp nhận khám trực tiếp (Walk-in)</h6>
            <form asp-action="WalkInCheckIn" method="post">
                <input type="hidden" name="facilityId" value="@activeFacId" />
                <input type="hidden" name="departmentId" value="@opdDeptId" />
                <div class="mb-2">
                    <label class="form-label small">Bệnh nhân *</label>
                    <select name="patientId" class="form-select form-select-sm" required>
                        @foreach (var p in patients)
                        {
                            <option value="@p.Id" selected="@(selectedPatientId == p.Id)">@p.PatientCode - @p.FullName</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Phòng khám *</label>
                    <select name="clinicId" class="form-select form-select-sm" required>
                        @foreach (var c in clinics)
                        {
                            <option value="@c.Id">@c.Name (@c.QueuePrefix)</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Lý do đến khám</label>
                    <input name="chiefComplaint" class="form-control form-control-sm" placeholder="Triệu chứng ban đầu..." />
                </div>
                <div class="mb-3">
                    <label class="form-label small">Độ ưu tiên</label>
                    <select name="priority" class="form-select form-select-sm">
                        <option value="0">Bình thường</option>
                        <option value="1">Ưu tiên (Người cao tuổi / Trẻ nhỏ)</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-sm btn-primary w-100">Tiếp nhận &amp; Cấp số thứ tự</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="sh-card p-3">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h6 class="fw-bold mb-0">Hàng đợi hôm nay (@Model.Count lượt)</h6>
                <form method="get" class="d-flex gap-2">
                    <select name="clinicId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- Tất cả phòng khám --</option>
                        @foreach (var c in clinics)
                        {
                            <option value="@c.Id" selected="@((Guid?)ViewBag.SelectedClinicId == c.Id)">@c.Name</option>
                        }
                    </select>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle small">
                    <thead class="table-light">
                        <tr><th>STT</th><th>Bệnh nhân</th><th>Phòng khám</th><th>Trạng thái</th><th class="text-end">Điều phối</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td><span class="badge bg-primary fs-6">@t.TicketNumber</span></td>
                                <td><strong>@t.PatientCode</strong> - @t.PatientName</td>
                                <td>@t.ClinicName</td>
                                <td><span class="badge bg-secondary">@t.TicketStatus</span></td>
                                <td class="text-end">
                                    <a asp-area="" asp-controller="Print" asp-action="QueueTicket" asp-route-ticketId="@t.TicketId" target="_blank" class="btn btn-sm btn-outline-secondary">In phiếu</a>
                                    @if (t.TicketStatus == QueueTicketStatus.Waiting)
                                    {
                                        <form asp-action="UpdateTicketStatus" method="post" class="d-inline">
                                            <input type="hidden" name="ticketId" value="@t.TicketId" />
                                            <input type="hidden" name="newStatus" value="@QueueTicketStatus.Called" />
                                            <button class="btn btn-sm btn-warning" type="submit">Gọi số</button>
                                        </form>
                                    }
                                    @if (t.TicketStatus is QueueTicketStatus.Waiting or QueueTicketStatus.Called)
                                    {
                                        <form asp-action="UpdateTicketStatus" method="post" class="d-inline">
                                            <input type="hidden" name="ticketId" value="@t.TicketId" />
                                            <input type="hidden" name="newStatus" value="@QueueTicketStatus.InProgress" />
                                            <button class="btn btn-sm btn-success" type="submit">Vào khám</button>
                                        </form>
                                    }
                                    <a asp-area="Clinical" asp-controller="Clinical" asp-action="Workspace" asp-route-id="@t.EncounterId" class="btn btn-sm btn-outline-primary">Mở EMR</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
