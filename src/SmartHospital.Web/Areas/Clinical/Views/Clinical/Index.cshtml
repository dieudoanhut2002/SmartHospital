@model SmartHospital.Contracts.Common.PagedResult<SmartHospital.Application.Clinical.EncounterWorklistItemDto>
@{
    ViewData["Title"] = "Danh sách khám bệnh (Clinical EMR)";
}

<div class="sh-card p-3">
    <div class="d-flex justify-content-between mb-3 flex-wrap gap-2">
        <form method="get" class="d-flex gap-2">
            <input name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Mã lượt khám, mã BN, tên BN..." />
            <button type="submit" class="btn btn-sm btn-outline-primary">Tìm</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã lượt khám</th>
                    <th>Bệnh nhân</th>
                    <th>Phòng khám / Khoa</th>
                    <th>Lý do khám</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@e.EncounterCode</td>
                        <td><strong>@e.PatientCode</strong> - @e.PatientName</td>
                        <td>@(e.ClinicName ?? e.DepartmentName)</td>
                        <td>@e.ChiefComplaint</td>
                        <td class="small">@HospitalTime.ToVietnamTime(e.StartedAtUtc).ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge bg-info text-dark">@e.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Workspace" asp-route-id="@e.EncounterId" class="btn btn-sm btn-primary">Mở hồ sơ khám</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
