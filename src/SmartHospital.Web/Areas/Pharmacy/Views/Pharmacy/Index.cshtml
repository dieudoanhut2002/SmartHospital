@model SmartHospital.Contracts.Common.PagedResult<SmartHospital.Application.Pharmacy.PrescriptionWorklistDto>
@{
    ViewData["Title"] = "Kho Dược & Cấp phát thuốc";
    var stock = ViewBag.Stock as IReadOnlyList<SmartHospital.Application.Pharmacy.MedicineStockSummaryDto> ?? [];
    var warehouses = ViewBag.Warehouses as IReadOnlyList<SmartHospital.Domain.Pharmacy.Warehouse> ?? [];
    var medicines = ViewBag.Medicines as IReadOnlyList<SmartHospital.Domain.Pharmacy.Medicine> ?? [];
    var activeFacId = (Guid)(ViewBag.ActiveFacilityId ?? Guid.Empty);
    var pharmWhId = warehouses.FirstOrDefault(w => w.WarehouseType == "Pharmacy")?.Id ?? warehouses.FirstOrDefault()?.Id ?? Guid.Empty;
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="sh-card p-3 mb-3">
            <h6 class="fw-bold mb-3">Đơn thuốc chờ cấp phát</h6>
            <table class="table table-sm align-middle small">
                <thead class="table-light">
                    <tr><th>Mã đơn</th><th>Bệnh nhân</th><th>Bác sĩ</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
                </thead>
                <tbody>
                    @foreach (var rx in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@rx.PrescriptionCode</td>
                            <td>@rx.PatientCode - @rx.PatientName</td>
                            <td>@rx.DoctorName</td>
                            <td><span class="badge bg-info text-dark">@rx.Status</span></td>
                            <td class="text-end">
                                <a asp-action="Dispense" asp-route-id="@rx.PrescriptionId" class="btn btn-sm btn-primary">Cấp phát</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="sh-card p-3 mb-3">
            <h6 class="fw-bold mb-2">Nhập lô thuốc vào kho</h6>
            <form asp-action="ReceiveBatch" method="post" class="row g-2">
                <input type="hidden" name="facilityId" value="@activeFacId" />
                <input type="hidden" name="warehouseId" value="@pharmWhId" />
                <div class="col-md-5">
                    <select name="medicineId" class="form-select form-select-sm" required>
                        @foreach (var m in medicines) { <option value="@m.Id">@m.Name</option> }
                    </select>
                </div>
                <div class="col-md-3"><input name="batchNumber" class="form-control form-control-sm" placeholder="Số lô*" required /></div>
                <div class="col-md-4"><input name="expiryDate" type="date" class="form-control form-control-sm" value="@DateTime.Now.AddYears(1).ToString("yyyy-MM-dd")" required /></div>
                <div class="col-md-4"><input name="quantity" type="number" step="1" min="1" class="form-control form-control-sm" placeholder="Số lượng*" required /></div>
                <div class="col-md-4"><input name="unitCost" type="number" step="100" min="0" class="form-control form-control-sm" placeholder="Giá nhập*" required /></div>
                <div class="col-md-4"><button type="submit" class="btn btn-sm btn-success w-100">+ Nhập kho</button></div>
            </form>
        </div>

        <div class="sh-card p-3">
            <h6 class="fw-bold mb-2">Tồn kho thuốc theo lô</h6>
            <div class="table-responsive">
                <table class="table table-sm small mb-0">
                    <thead class="table-light"><tr><th>Thuốc</th><th>Số lô</th><th>HSD</th><th class="text-end">Tồn</th><th>Cảnh báo</th></tr></thead>
                    <tbody>
                        @foreach (var s in stock)
                        {
                            <tr>
                                <td>@s.MedicineName</td>
                                <td><code>@s.BatchNumber</code></td>
                                <td>@s.ExpiryDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-bold">@s.QuantityOnHand @s.BaseUnit</td>
                                <td>
                                    @if (s.IsExpired) { <span class="badge bg-danger">Hết hạn</span> }
                                    else if (s.IsExpiringSoon) { <span class="badge bg-warning text-dark">Sắp hết hạn</span> }
                                    @if (s.IsLowStock) { <span class="badge bg-danger">Tồn thấp</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
